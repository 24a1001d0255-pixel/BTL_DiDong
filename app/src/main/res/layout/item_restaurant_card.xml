<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRestaurantRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgRestaurant"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            android:background="@drawable/bg_card"
            android:contentDescription="Restaurant image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvRestaurantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phở bò gia truyền Định Công"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_dark"
                    android:layout_toStartOf="@id/btnSaveBookmark"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="6dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Frame Bookmark Button (Unfilled Frame by default) -->
                <ImageView
                    android:id="@+id/btnSaveBookmark"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/forest_green"
                    android:padding="6dp"
                    android:background="@drawable/bg_bookmark_unsaved"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Bookmark icon" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvRestaurantSub"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="1.2 km · 16 phút · 40k–90k"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvRestaurantRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.8"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/forest_green" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Tag Chips Row (Equal Width Horizontally Below) -->
    <LinearLayout
        android:id="@+id/containerTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tag1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Phở"
            android:textSize="11sp"
            android:textColor="@color/brown_accent"
            android:background="#FCE8E2"
            android:paddingHorizontal="4dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tag2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Món Việt"
            android:textSize="11sp"
            android:textColor="@color/brown_accent"
            android:background="#FCE8E2"
            android:paddingHorizontal="4dp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/tagMatch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Khớp Phở"
            android:textSize="11sp"
            android:textColor="@color/forest_green"
            android:background="#E8F0EE"
            android:paddingHorizontal="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
