<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_bg">

    <!-- Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackMapPicker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_dark"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Chọn vị trí trên bản đồ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Map Container with Center Pin -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/mapPickerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Center Pin Marker (Grab Style) -->
        <ImageView
            android:id="@+id/imgCenterPin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_map"
            app:tint="@color/forest_green"
            android:layout_centerInParent="true"
            android:contentDescription="Pin" />
    </RelativeLayout>

    <!-- Bottom Selected Location Info & Confirm Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐỊA CHỈ ĐÃ CHỌN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brown_accent" />

        <TextView
            android:id="@+id/tvMapPickerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang di chuyển bản đồ..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmMapLocation"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Xác nhận vị trí này"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/forest_green"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
