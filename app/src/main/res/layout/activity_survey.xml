<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KHẢO SÁT GU ĂN UỐNG"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/brown_accent"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tìm món ăn chuẩn gu bạn"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="16dp" />

        <!-- Question 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Khẩu vị ưu tiên của bạn?"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(Cho phép chọn nhiều)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgTaste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpicy"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cay" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSalty"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đậm đà / Mặn" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSweet"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngọt" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLight"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thanh nhẹ" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSourSweet"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chua ngọt" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Question 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Ngân sách trung bình/người?"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(Chọn một mức)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBudget30"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dưới 30k (Phù hợp ăn nhanh, bình dân)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBudget60"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30k - 60k (Phổ biến)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBudget100"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60k - 100k (Thoải mái hơn)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBudgetAbove100"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trên 100k (Sang xịn mịn)" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Question 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Phương tiện &amp; Bán kính di chuyển?"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(Chọn một mức - Khớp thanh trượt ngoài app)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWalk"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đi bộ (Dưới 1 km)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBike"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xe máy / Xe đạp (1 km - 3 km)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFar"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đi xa hơn (Trên 3 km)" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Question 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Thành phần hoặc món cần tránh?"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(Cho phép chọn nhiều - Tránh trùng lặp với khẩu vị)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgAvoid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAvoidGarlic"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không ăn hành / Tỏi" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAvoidSeafood"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tránh Hải sản" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAvoidOrgan"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tránh Nội tạng" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAvoidFat"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tránh đồ béo / Nhiều dầu mỡ" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAvoidVegetarian"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đồ chay / Thanh đạm" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitSurvey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Hoàn tất khảo sát"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/forest_green"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Skip Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipSurvey"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Bỏ qua"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            app:strokeColor="@color/stroke_color"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
