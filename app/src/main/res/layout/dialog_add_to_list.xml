<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvAddDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Chọn quán / món thêm vào danh sách"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnCloseAddDialog" />

        <ImageView
            android:id="@+id/btnCloseAddDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_muted"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvAddDialogSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bấm vào lá cờ xanh để chọn, bấm vào quán để xem thông tin chi tiết:"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="12dp" />

    <!-- RecyclerView for Full Restaurant Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAddListPlaces"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:scrollbars="vertical" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmAddToList"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="LƯU VÀO DANH SÁCH"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/forest_green"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
