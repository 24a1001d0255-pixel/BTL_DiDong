<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvListDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁 Quán trưa văn phòng"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <ImageView
            android:id="@+id/btnCloseListDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="#F0F0F0"
            android:padding="6dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Close" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvListDialogSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh sách quán ăn đã lưu:"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="12dp" />

    <!-- RecyclerView for restaurants in this list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvListDialogPlaces"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:nestedScrollingEnabled="true" />

</LinearLayout>
