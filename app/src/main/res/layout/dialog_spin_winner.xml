<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉 KẾT QUẢ QUAY MÓN"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/brown_accent"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvWinnerFoodName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cơm"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/forest_green"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hệ thống đã tìm thấy danh sách quán ngon gần bạn nhất bán món này!"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:textAlignment="center"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSeeWinnerPlaces"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Xem các quán gần bạn"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/forest_green"
        app:cornerRadius="12dp" />

</LinearLayout>
